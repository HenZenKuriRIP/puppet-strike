# Android release signing — copy to .env.android (gitignored). NEVER commit real secrets.
# Paths are examples only; use your own machine-local paths (no personal home paths in git).

# Absolute or project-relative path to the upload keystore (outside the repo recommended)
KEYSTORE_FILE=../secrets/puppet-strike-upload.jks
KEYSTORE_ALIAS=puppetstrike
KEYSTORE_PASSWORD=
KEY_PASSWORD=

# Optional Play / CI placeholders (leave blank locally)
# PLAY_SERVICE_ACCOUNT_JSON=
