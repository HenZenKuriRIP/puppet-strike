{
  "name": "puppet-strike",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run check:case && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:e2e": "npm run check:case && tsc --noEmit && vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "npm run build:e2e && node scripts/e2e.mjs",
    "test:balance": "BALANCE=1 vitest run src/tests/balance.report.test.ts && python3 scripts/balance-report.py",
    "test:perf": "PERF=1 vitest run src/tests/perf.report.test.ts",
    "check:case": "node scripts/check-case.mjs",
    "server": "node server/ws-server.mjs",
    "dev:coop": "node scripts/dev-coop.mjs",
    "test:coop": "npm run build:e2e && node scripts/coop-e2e.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:dev": "npm run build && npx cap sync android && npx cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:release": "npm run build && npx cap sync android && node scripts/android-release-hint.mjs",
    "cap:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.16.3",
    "@react-three/rapier": "^1.5.0",
    "@types/ws": "^8.18.2",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "ws": "^8.22.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
